# Ask rustc for the native dependencies of the selected staticlib. Cargo's JSON
# build-script messages provide the active native library search directories.
set(_features)
if(MACOS_DEPLOYMENT_TARGET)
    # Apply the plugin's minimum OS version to Rust and native build scripts.
    set(ENV{MACOSX_DEPLOYMENT_TARGET} "${MACOS_DEPLOYMENT_TARGET}")
endif()
if(FEATURES)
    list(APPEND _features --features "${FEATURES}")
endif()
execute_process(COMMAND "${CARGO}" rustc --manifest-path "${ROOT}/Cargo.toml"
    --target-dir "${TARGET_DIR}" --release --locked --no-default-features
    ${_features} --lib --crate-type staticlib --message-format=json
    -- --print native-static-libs
    OUTPUT_VARIABLE _messages ERROR_VARIABLE _diagnostics RESULT_VARIABLE _result)
message("${_diagnostics}")
if(NOT _result EQUAL 0)
    message("${_messages}")
    message(FATAL_ERROR "ReaSpeech static library build failed")
endif()
set(_response "")
set(_search_paths)
string(REPLACE "\n" ";" _lines "${_messages}")
foreach(_line IN LISTS _lines)
    if(NOT _line MATCHES "^\\{")
        continue()
    endif()
    string(JSON _reason ERROR_VARIABLE _error GET "${_line}" reason)
    if(_reason STREQUAL "compiler-message")
        string(JSON _text GET "${_line}" message message)
        string(APPEND _diagnostics "\n${_text}")
    endif()
    if(_reason STREQUAL "build-script-executed")
        string(JSON _count LENGTH "${_line}" linked_paths)
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_index RANGE 0 ${_last})
                string(JSON _path GET "${_line}" linked_paths ${_index})
                set(_search_flag "-L")
                if(_path MATCHES "^framework=")
                    set(_search_flag "-F")
                endif()
                string(REGEX REPLACE "^(native|dependency|crate|all|framework)=" "" _path "${_path}")
                list(APPEND _search_paths "${_path}")
                if(MSVC)
                    string(APPEND _response "/LIBPATH:\"${_path}\"\n")
                else()
                    string(APPEND _response "${_search_flag}\"${_path}\"\n")
                endif()
            endforeach()
        endif()
    endif()
endforeach()
string(REGEX MATCH "native-static-libs: ([^\r\n]+)" _match "${_diagnostics}")
if(NOT _match)
    message(FATAL_ERROR "rustc did not report native static library dependencies")
endif()
set(_libraries "${CMAKE_MATCH_1}")
string(APPEND _response "${_libraries}\n")
file(WRITE "${RESPONSE}" "${_response}")
if(MSVC)
    # MSBuild passes link options through its own response file; link.exe does
    # not expand nested response files. An object with /DEFAULTLIB directives
    # carries the dependencies without requiring a second configure pass.
    separate_arguments(_native_libraries WINDOWS_COMMAND "${_libraries}")
    set(_source "")
    foreach(_lib IN LISTS _native_libraries)
        string(REGEX REPLACE "^/[Dd][Ee][Ff][Aa][Uu][Ll][Tt][Ll][Ii][Bb]:" "" _lib "${_lib}")
        if(NOT _lib MATCHES "\\.lib$")
            string(APPEND _lib ".lib")
        endif()
        string(REGEX REPLACE "\\.lib$" "" _name "${_lib}")
        unset(_resolved)
        find_file(_resolved NAMES "${_lib}" "lib${_name}.a" PATHS ${_search_paths} NO_DEFAULT_PATH NO_CACHE)
        if(_resolved)
            set(_lib "${_resolved}")
        endif()
        file(TO_CMAKE_PATH "${_lib}" _lib)
        string(APPEND _source "#pragma comment(lib, \"${_lib}\")\n")
    endforeach()
    file(WRITE "${TARGET_DIR}/native-libs.c" "${_source}")
    execute_process(COMMAND "${C_COMPILER}" /nologo /c /Zl
        "${TARGET_DIR}/native-libs.c" "/Fo${NATIVE_OBJECT}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Could not generate ReaSpeech native link directives")
    endif()
endif()
